    {
        "id": "6995ffc3d05d1d45",
        "type": "function",
        "z": "08e6ddee028c6160",
        "g": "887d08d3eb394a9a",
        "name": "Processa Sensores",
        "func": "const d = msg.payload;\n\n// Guarda última leitura para uso em /status do Telegram\nglobal.set('ultimosSensores', d);\n\n// 1) Ponto para o InfluxDB (measurement = \"sensores\")\n// IMPORTANTE: o plugin influxdb (1.x) deve receber msg.payload como OBJETO\n// simples { campo: valor } e o measurement em msg.measurement. Enviar um\n// array [{...}] aqui gera o erro \"val.slice is not a function\".\nconst influxMsg = {\n    payload: {\n        temperatura: d.temperatura,\n        umidade: d.umidade,\n        pressao_pa: d.pressao_pa,\n        nh3_ppm: d.nh3_ppm,\n        rssi: d.rssi,\n        snr: d.snr\n    },\n    measurement: 'sensores'\n};\n\nreturn [\n    influxMsg,\n    { payload: d.temperatura },\n    { payload: d.umidade },\n    { payload: Math.round(d.pressao_pa / 100) }, // Pa -> hPa\n    { payload: d.nh3_ppm },\n    msg\n];",
        "outputs": 6,
        "timeout": 0,
        "noerr": 0,
