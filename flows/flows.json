        "func": "const d = msg.payload;\n\n// Atualiza contexto global - usado ao montar novos comandos\nglobal.set('estadoAtuadores', { v1: d.v1, v2: d.v2, asp: d.asp, neb: d.neb });\n\n// Mesmo formato corrigido: objeto simples + msg.measurement (evita\n// \"val.slice is not a function\" no plugin influxdb 1.x)\nconst influxMsg = { payload: { v1: d.v1, v2: d.v2, asp: d.asp, neb: d.neb }, measurement: 'atuadores' };\n\nreturn [\n    influxMsg,\n    { payload: d.v1 === 1 },\n    { payload: d.v2 === 1 },\n    { payload: d.asp === 1 },\n    { payload: d.neb === 1 }\n];",
