    {
        "id": "da2a9acb3dcb2e55",
        "type": "function",
        "z": "08e6ddee028c6160",
        "g": "887d08d3eb394a9a",
        "name": "Verifica Limites / Automação / Alertas",
        "func": "const d = msg.payload;\n\n// ===== LIMITES (ajuste conforme a necessidade) =====\nconst LIM_TEMP_MAX = 32; // °C\nconst LIM_TEMP_MIN = 15; // °C\nconst LIM_UMID_MAX = 80; // %\nconst LIM_NH3_MAX  = 25; // ppm\n\nconst alertas = [];\nif (d.temperatura > LIM_TEMP_MAX) alertas.push(`🌡️ Temperatura ALTA: ${d.temperatura} °C (limite ${LIM_TEMP_MAX} °C)`);\nif (d.temperatura < LIM_TEMP_MIN) alertas.push(`🥶 Temperatura BAIXA: ${d.temperatura} °C (limite ${LIM_TEMP_MIN} °C)`);\nif (d.umidade > LIM_UMID_MAX) alertas.push(`💧 Umidade ALTA: ${d.umidade} % (limite ${LIM_UMID_MAX} %)`);\nif (d.nh3_ppm > LIM_NH3_MAX) alertas.push(`☣️ Amônia (NH3) ALTA: ${d.nh3_ppm} ppm (limite ${LIM_NH3_MAX} ppm)`);\n\n// ===== MODO AUTOMÁTICO =====\n// Se ativado pelo switch \"Modo Automático\" no dashboard, o sistema ajusta\n// os atuadores automaticamente conforme os limites acima.\nlet autoMsg = null;\nif (global.get('modoAutomatico') === true) {\n    const estado = Object.assign({ v1: 0, v2: 0, asp: 0, neb: 0 }, global.get('estadoAtuadores') || {});\n    const novo = Object.assign({}, estado);\n\n    novo.v1  = (d.temperatura > LIM_TEMP_MAX) ? 1 : 0;\n    novo.v2  = (d.temperatura > LIM_TEMP_MAX) ? 1 : 0;\n    novo.neb = (d.nh3_ppm > LIM_NH3_MAX || d.temperatura > LIM_TEMP_MAX) ? 1 : 0;\n    novo.asp = (d.umidade < 40) ? 1 : 0; // exemplo: aspersor liga se umidade muito baixa\n\n    if (JSON.stringify(novo) !== JSON.stringify(estado)) {\n        global.set('estadoAtuadores', novo);\n        autoMsg = { payload: novo };\n    }\n}\n\nif (alertas.length === 0) return [null, null, autoMsg];\n\nconst texto = `⚠️ ALERTA AVIÁRIO ⚠️\\n\\n` + alertas.join('\\n') +\n  `\\n\\nLeitura completa:\\nTemp: ${d.temperatura} °C | Umid: ${d.umidade} % | NH3: ${d.nh3_ppm} ppm | Pressão: ${Math.round(d.pressao_pa/100)} hPa`;\n\nconst msgTelegram = { payload: { type: 'message', content: texto, chatId: global.get('telegramChatId') } };\n// 'to' precisa estar na RAIZ da mensagem para o nó e-mail - se o campo\n// \"To\" do nó ficar vazio ou for ignorado, isso evita o erro\n// \"No recipients defined\".\nconst msgEmail = { to: global.get('emailDestino'), topic: 'Alerta - Sistema de Monitoramento do Aviário', payload: texto };\n\nreturn [msgTelegram, msgEmail, autoMsg];",
        "outputs": 3,
        "timeout": 0,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
