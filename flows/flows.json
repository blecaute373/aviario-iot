    {
        "id": "acb022602412f325",
        "type": "function",
        "z": "08e6ddee028c6160",
        "g": "56225f11184e9e7e",
        "name": "Processa Comandos Telegram",
        "func": "const texto = ((msg.payload && msg.payload.content) || '').trim().toLowerCase();\nconst chatId = msg.payload.chatId;\n\nconst estado = Object.assign({ v1: 0, v2: 0, asp: 0, neb: 0 }, global.get('estadoAtuadores') || {});\nconst ultimosSensores = global.get('ultimosSensores') || {};\n\nlet resposta = null;\nlet comando = false;\n\nswitch (texto) {\n    case '/status':\n        resposta = '📊 Status do Aviário\\n\\n' +\n          'Temp: ' + (ultimosSensores.temperatura ?? '--') + ' °C\\n' +\n          'Umidade: ' + (ultimosSensores.umidade ?? '--') + ' %\\n' +\n          'NH3: ' + (ultimosSensores.nh3_ppm ?? '--') + ' ppm\\n' +\n          'Pressão: ' + (ultimosSensores.pressao_pa ? Math.round(ultimosSensores.pressao_pa / 100) : '--') + ' hPa\\n\\n' +\n          'Ventilador 1: ' + (estado.v1 ? 'ON' : 'OFF') + '\\n' +\n          'Ventilador 2: ' + (estado.v2 ? 'ON' : 'OFF') + '\\n' +\n          'Aspersor: ' + (estado.asp ? 'ON' : 'OFF') + '\\n' +\n          'Nebulizador: ' + (estado.neb ? 'ON' : 'OFF') + '\\n\\n' +\n          'Modo automático: ' + (global.get('modoAutomatico') ? 'ATIVADO' : 'DESATIVADO');\n        break;\n    case '/v1_on':  estado.v1 = 1; comando = true; resposta = 'Ventilador 1 LIGADO'; break;\n    case '/v1_off': estado.v1 = 0; comando = true; resposta = 'Ventilador 1 DESLIGADO'; break;\n    case '/v2_on':  estado.v2 = 1; comando = true; resposta = 'Ventilador 2 LIGADO'; break;\n    case '/v2_off': estado.v2 = 0; comando = true; resposta = 'Ventilador 2 DESLIGADO'; break;\n    case '/asp_on':  estado.asp = 1; comando = true; resposta = 'Aspersor LIGADO'; break;\n    case '/asp_off': estado.asp = 0; comando = true; resposta = 'Aspersor DESLIGADO'; break;\n    case '/neb_on':  estado.neb = 1; comando = true; resposta = 'Nebulizador LIGADO'; break;\n    case '/neb_off': estado.neb = 0; comando = true; resposta = 'Nebulizador DESLIGADO'; break;\n    case '/help':\n    case '/start':\n        resposta = '🐔 Bot Aviário\\n\\nComandos disponíveis:\\n/status - leituras e estado atual\\n/v1_on /v1_off - Ventilador 1\\n/v2_on /v2_off - Ventilador 2\\n/asp_on /asp_off - Aspersor\\n/neb_on /neb_off - Nebulizador';\n        break;\n    default:\n        resposta = 'Comando não reconhecido. Envie /help para ver os comandos disponíveis.';\n}\n\nconst out1 = { payload: { type: 'message', content: resposta, chatId: chatId } };\nlet out2 = null;\n\nif (comando) {\n    global.set('estadoAtuadores', estado);\n    out2 = { payload: { v1: estado.v1, v2: estado.v2, asp: estado.asp, neb: estado.neb } };\n}\n\nreturn [out1, out2];",
        "outputs": 2,
        "timeout": 0,
        "noerr": 0,
