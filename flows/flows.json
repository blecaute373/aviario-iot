        "id": "bce8efc81748caaf",
        "type": "function",
        "z": "08e6ddee028c6160",
        "g": "69358b212fa88a64",
        "name": "Define Configurações Globais",
        "func": "// >>>>>>>>>> EDITE AQUI <<<<<<<<<<\n// Chat ID do Telegram para onde os alertas serão enviados.\n// Para descobrir: converse com @myidbot (ou @userinfobot) no Telegram.\nif (global.get('telegramChatId') === undefined) {\n    global.set('telegramChatId', '6163223530');\n}\n\n// Modo automático: se true, o sistema liga/desliga os atuadores\n// automaticamente conforme os limites definidos em \"Verifica Limites\".\nif (global.get('modoAutomatico') === undefined) {\n    global.set('modoAutomatico', false);\n}\n\n// E-mail de destino dos alertas (Gmail). É enviado em msg.to junto com\n// o alerta - evita o erro \"No recipients defined\" caso o campo \"To\"\n// do nó e-mail não seja preenchido corretamente.\nif (global.get('emailDestino') === undefined) {\n    global.set('emailDestino', 'deivisson.linojr@gmail.com');\n}\n\n// Estado inicial conhecido dos atuadores (será atualizado pelo tópico de estado)\nif (global.get('estadoAtuadores') === undefined) {\n    global.set('estadoAtuadores', { v1: 0, v2: 0, asp: 0, neb: 0 });\n}\n\nreturn msg;",
