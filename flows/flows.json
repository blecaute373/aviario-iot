        "id": "2e13dd54054a30ba",
        "type": "telegram receiver",
        "z": "08e6ddee028c6160",
        "g": "56225f11184e9e7e",
        "name": "Telegram - Comandos",
        "bot": "cfg_telegram",
        "saveDataDir": "",
