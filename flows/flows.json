        "name": "Monta Comando JSON",
        "func": "// Recupera o último estado conhecido dos atuadores\nconst estado = Object.assign({ v1: 0, v2: 0, asp: 0, neb: 0 }, global.get('estadoAtuadores') || {});\n\n// msg.topic indica qual atuador foi alterado (v1, v2, asp, neb)\n// msg.payload é true/false vindo do switch do dashboard\nestado[msg.topic] = msg.payload ? 1 : 0;\n\nglobal.set('estadoAtuadores', estado);\n\nmsg.payload = {\n    v1: estado.v1,\n    v2: estado.v2,\n    asp: estado.asp,\n    neb: estado.neb\n};\n\nreturn msg;",
